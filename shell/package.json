    "marked": "^18.0.12",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.3",
    "happy-dom": "^18.0.1",
    "jsdom": "^30.1.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.0",
