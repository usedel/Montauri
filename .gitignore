# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
.uv/

# Rust
target/

# Node / 前端
node_modules/
shell/dist/

# Playwright（E2E 产物：trace/截图/last-run；tr-<id> 为调试期临时改名，防止误提交）
playwright-report/
test-results/
.playwright-artifacts-*/
old-tr-*/
# 真机 CDP 脚本运行时日志（e2e-real/*.cjs 落盘的 tauri dev 输出）
shell/e2e-real/.tauri-dev*.log

# 真机跑批报告（每次调用落一个 <stamp>/ 目录：SUMMARY.md + 各套件 JSON）
# 与 test-results/ 同性质——**原始运行产物**，一次跑一份、含中断/失败跑，无评审价值却无限增长
# （2026-10-07 一天就积了 13 份，其中 4 份是中断跑）。
# 结论与证据以「写进 docs 的数字 + bench/reports/」为准；确需留证某次里程碑跑时
# 用 `git add -f shell/real-reports/<stamp>` 单独提升入库。
shell/real-reports/

# bench 报告（原始运行产物：budget 滚动快照 + 探针 JSON/报告，见下方证据迁移说明）
# 结论与数字以「写进 docs 的数字」为准；确需留证某次里程碑跑时用
# `git add -f bench/reports/<file>` 单独提升入库（2026-10-08 整目录治理）。
bench/reports/

# Zed / IDE
.DS_Store
*.swp

# 运行时产物（trace 库、bench 报告临时文件）
~/.montauri/
*.db
*.db-wal
*.db-shm

# debugpy vendor 拉取产物（tools/fetch-debugpy.ps1 按 sha256 锁定生成，不入库）
vendor/

# CI 本地缓存
ci/.cache/

# 临时提交信息文件（提交辅助脚本用）
.git-commit-msg.tmp
# 本机生成的 cargo 链接配置（tools/msvc-env.ps1 走进程环境变量，不再落 .cargo/config.toml）
shell/.cargo/
# AI 助手工作区数据（非项目产物）
.workbuddy-ai/
# 过程中生成的临时脚本与产物
scripts/_tmp/
