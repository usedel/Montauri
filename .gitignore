# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
.uv/

# Rust
target/

# Node / 前端
node_modules/
shell/dist/

# Playwright（E2E 产物：trace/截图/last-run；tr-<id> 为调试期临时改名，防止误提交）
playwright-report/
test-results/
.playwright-artifacts-*/
old-tr-*/
# 真机 CDP 脚本运行时日志（e2e-real/*.cjs 落盘的 tauri dev 输出）
shell/e2e-real/.tauri-dev*.log

# Zed / IDE
.DS_Store
*.swp

# 运行时产物（trace 库、bench 报告临时文件）
~/.opencharm/
*.db
*.db-wal
*.db-shm

# debugpy vendor 拉取产物（tools/fetch-debugpy.ps1 按 sha256 锁定生成，不入库）
vendor/

# CI 本地缓存
ci/.cache/

# 临时提交信息文件（提交辅助脚本用）
.git-commit-msg.tmp